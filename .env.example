# Local runtime
FLEETPLANE_MODE=local
FLEETPLANE_SQLITE_PATH=.fleetplane/cloud.db
FLEETPLANE_MAX_REQUEST_BYTES=262144
FLEETPLANE_LOG_LEVEL=INFO
FLEETPLANE_CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080

# Optional local API guard. Leave unset only for local development.
# FLEETPLANE_ADMIN_KEY=replace-me

# Azure runtime (used when FLEETPLANE_MODE=azure)
# FLEETPLANE_COSMOS_ENDPOINT=https://<account>.documents.azure.com:443/
# FLEETPLANE_COSMOS_DATABASE=fleetplane
# FLEETPLANE_COSMOS_CONTAINER=control
# FLEETPLANE_COSMOS_SUMMARY_CONTAINER=summaries
# FLEETPLANE_IOTHUB_HOST_NAME=<hub>.azure-devices.net

# Microsoft IoT platform mapping
# FLEETPLANE_DEVICE_REGISTRY_NAMESPACE=adr-fleetplane-prod
# FLEETPLANE_DPS_ID_SCOPE=<dps-id-scope>
# FLEETPLANE_AZURE_RESOURCE_GROUP=rg-fleetplane
# FLEETPLANE_AZURE_LOCATION=northeurope
